{
  "name": "poppins-bakers-cake-sale",
  "private": true,
  "version": "1.0.0",
  "description": "Vailankanni Parish Youth x Poppins Bakers Christmas cake pre-orders (Netlify + Google Sheets)",
  "scripts": {
    "dev": "netlify dev",
    "test": "node tests/run-all.mjs",
    "zip": "npm run build && node scripts/make-drop-zip.mjs",
    "build": "tailwindcss -i src/tailwind.css -o public/tailwind.css --minify",
    "build:watch": "tailwindcss -i src/tailwind.css -o public/tailwind.css --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5"
  }
}
